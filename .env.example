# Server
NODE_ENV=development
PORT=5000
# Frontend origin(s). Comma-separate Firebase Hosting URLs in production:
# CLIENT_URL=https://your-app.web.app,https://your-app.firebaseapp.com
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/lfe_platform

# Auth — generate a long random string for JWT_SECRET
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
COOKIE_NAME=lfe_token

# First admin (created on boot if no admin exists)
ADMIN_EMAIL=admin@iub.edu.bd
ADMIN_PASSWORD=change-me-admin-password

# Optional: require @iub.edu.bd emails for student registration
REQUIRE_IUB_EMAIL=false

# Posts: auto-approve on create (set false to require moderation)
AUTO_APPROVE_POSTS=true

# Image storage: cloudinary | local
IMAGE_STORAGE_PROVIDER=cloudinary
IMAGE_STORAGE_CLOUD_NAME=p322twby
IMAGE_STORAGE_API_KEY=
IMAGE_STORAGE_API_SECRET=
# Or one line instead of key + secret:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Email (leave blank to log reset/verify links in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LFE Platform <noreply@iub.edu.bd>
